    "site_page_viewed": {
      "serverOnly": false,
      "requiresScreen": false,
      "properties": {
        "page_kind": {
          "kind": "enum",
          "values": [
            "home",
            "blog_article",
            "blog_index",
            "catalog_package",
            "catalog_index",
            "catalog_other",
            "pricing",
            "features",
            "docs",
            "other"
          ]
        },
        "page_path": {
          "kind": "string",
          "pattern": "^\\/(?:[a-z0-9][a-z0-9._-]{0,78}\\/){0,6}$",
          "optional": true
        },
        "package_version_id": {
          "kind": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "optional": true
        },
        "source": {
          "kind": "enum",
          "values": [
            "direct",
            "search",
            "social",
            "referral",
            "internal",
            "unknown"
          ]
        },
        "device_category": {
          "kind": "enum",
          "values": [
            "desktop",
            "mobile",
            "tablet",
            "unknown"
          ]
        },
        "referrer_host": {
          "kind": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "optional": true
        },
        "utm_source": {
          "kind": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
          "optional": true
        },
        "utm_medium": {
          "kind": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
          "optional": true
