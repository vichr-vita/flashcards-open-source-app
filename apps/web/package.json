{
  "name": "flashcards-open-source-app-web",
  "version": "1.29.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "FLASHCARDS_E2E_TARGET=prod playwright test",
    "test:e2e:local": "node ./scripts/check-local-e2e-stack.mjs && FLASHCARDS_E2E_TARGET=local playwright test",
    "test:e2e:review-ui": "tsc -p e2e/review-ui/tsconfig.json && playwright test --config playwright.review-ui.config.ts",
    "test:e2e:prod": "FLASHCARDS_E2E_TARGET=prod playwright test"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@sentry/react": "^10.75.2",
    "heic-to": "^1.5.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.49.0",
    "micromark": "^4.0.2",
    "micromark-util-decode-string": "^2.0.1",
    "qrcode.react": "^4.2.0",
    "ratex-wasm": "0.1.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "@tanstack/react-router": "^1.131.0",
    "@tanstack/react-query": "^5.90.0",
    "effect": "^3.18.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "@types/mdast": "^4.0.4"
  },
  "engines": {
    "node": "24.x"
  }
