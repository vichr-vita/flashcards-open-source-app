{
  "name": "lingvichr-private",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build:web": "pnpm --dir apps/web build && node scripts/build-passkey.mjs",
    "build:docs": "pnpm --dir apps/docs build",
    "check": "bash scripts/check-rust-stack.sh",
    "generate:types": "cargo run --locked --bin lingvichr -- generate-types"
  },
  "engines": { "node": "24.x" },
  "devDependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "esbuild": "0.28.2"
  }
}
